---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getAllArticles } from '../../utils/wordpress';
import imgMountain from '../../assets/images/hero-mountain.jpg';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const articles = await getAllArticles();

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Artikel — INLA SUMUT"
  description="Cerita, wawasan, dan kabar terbaru dari INLA SUMUT — International Nature Loving Association Sumatera Utara."
  ogImage={imgMountain}
>
  <Navbar />

  <!-- HERO -->
  <section class="hero-activities">
    <p class="hero-eyebrow">Blog &amp; Wawasan</p>
    <h1 class="hero-h1">Cerita &amp; <em>Artikel</em> INLA SUMUT</h1>
    <p class="hero-p">Kabar kegiatan, wawasan, dan cerita seputar alam dan kemanusiaan dari komunitas INLA SUMUT.</p>
  </section>

  <section class="artikel-grid-section">
    <div class="artikel-grid">
      {articles.map((article) => (
        <a href={`${BASE}/artikel/${article.slug}`} class="artikel-card">
          <div class="artikel-card-thumb">
            {article.featuredImage ? (
              <img src={article.featuredImage} alt={article.title} loading="lazy" />
            ) : (
              <div class="artikel-card-thumb-fallback" aria-hidden="true">📰</div>
            )}
          </div>
          <div class="artikel-card-body">
            {article.categories.length > 0 && (
              <div class="artikel-card-tags">
                {article.categories.map((cat) => <span class="artikel-tag">{cat}</span>)}
              </div>
            )}
            <h2 class="artikel-card-title">{article.title}</h2>
            <p class="artikel-card-excerpt">{article.excerpt}</p>
            <div class="artikel-card-footer">
              <span class="artikel-detail-link">Baca Selengkapnya <span class="arrow">→</span></span>
              <span class="artikel-card-date">{formatDate(article.publishedAt)}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {articles.length === 0 && (
      <div class="artikel-empty">
        <p>Belum ada artikel yang dipublikasikan.</p>
      </div>
    )}
  </section>

  <Footer />
</Layout>

<style>
  .artikel-grid-section {
    padding: 64px 40px 96px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .artikel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .artikel-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 0.5px solid #d8d4ca;
    box-shadow: 0 2px 12px rgba(28, 46, 28, 0.05);
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .artikel-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 36px rgba(28, 46, 28, 0.13);
  }

  .artikel-card-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #f5f2ec;
    overflow: hidden;
  }
  .artikel-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .artikel-card:hover .artikel-card-thumb img { transform: scale(1.05); }
  .artikel-card-thumb-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    opacity: 0.35;
  }

  .artikel-card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .artikel-card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .artikel-tag {
    font-size: 11px;
    font-weight: 600;
    color: #3d7a3d;
    background: rgba(61, 122, 61, 0.1);
    padding: 3px 10px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .artikel-card-title {
    font-size: 17px;
    font-weight: 600;
    color: #1c2e1c;
    line-height: 1.4;
    margin: 0 0 8px;
  }
  .artikel-card-excerpt {
    font-size: 13px;
    color: #6a6a5a;
    line-height: 1.65;
    margin: 0 0 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .artikel-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 0.5px solid #ece8de;
  }
  .artikel-detail-link {
    font-size: 12px;
    font-weight: 600;
    color: #3d7a3d;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .artikel-card:hover .artikel-detail-link .arrow { transform: translateX(3px); }
  .artikel-detail-link .arrow { display: inline-block; transition: transform 0.2s ease; }
  .artikel-card-date { font-size: 11px; color: #9a9a8a; }

  .artikel-empty {
    text-align: center;
    padding: 80px 20px;
    color: #9a9a8a;
    font-size: 15px;
  }

  @media (max-width: 1024px) {
    .artikel-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .artikel-grid-section { padding: 48px 20px 72px; }
    .artikel-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
  }
</style>
