---
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="nav-wrap">
  <nav class="nav">
    <a href={BASE + '/'} class="nav-brand">
      <img src={BASE + '/SRC/logo-inla-sumut.png'} alt="INLA" width="42" height="42" class="nav-icon-img" />
      <span class="nav-name-wrap"><span class="nav-name">INLA SUMUT</span></span>
    </a>

    <div class="nav-links">
      <span class="nav-indicator" id="nav-indicator" aria-hidden="true"></span>
      <a href={BASE + '/'}            class:list={['nav-link', { active: activePage === 'home' }]}>Home</a>
      <a href={BASE + '/about'}       class:list={['nav-link', { active: activePage === 'about' }]}>About Us</a>
      <a href={BASE + '/activities'}  class:list={['nav-link', { active: activePage === 'activities' }]}>Kegiatan</a>
    </div>

    <div class="nav-actions">
      <a href={BASE + '/karir'} class:list={['nav-btn', 'nav-cta', { active: activePage === 'karir' }]}>
        <span class="nav-btn-text">Bergabung</span>
      </a>
      <button class="nav-hamburger" aria-label="Buka menu" type="button">
        <span class="nav-hamburger-label nav-hamburger-label-open">Menu</span>
        <span class="nav-hamburger-label nav-hamburger-label-close">Tutup</span>
      </button>
    </div>
  </nav>
</div>

<div class="nav-drawer">
  <a href={BASE + '/'}           class:list={['nav-link', { active: activePage === 'home' }]}>Home</a>
  <a href={BASE + '/about'}      class:list={['nav-link', { active: activePage === 'about' }]}>About Us</a>
  <a href={BASE + '/activities'} class:list={['nav-link', { active: activePage === 'activities' }]}>Kegiatan</a>
  <a href={BASE + '/karir'}      class="nav-btn">Bergabung</a>
</div>
